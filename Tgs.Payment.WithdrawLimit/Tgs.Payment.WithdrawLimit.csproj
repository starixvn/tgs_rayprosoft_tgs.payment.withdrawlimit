<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<UserSecretsId>a01b3f48-e59b-4d55-a354-c0cbdb2f3d1e</UserSecretsId>
	<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	<DockerfileTag Condition="$(DockerfileTag) == ''">pgtgs/payment-withdraw-limit</DockerfileTag>
  </PropertyGroup>

  <ItemGroup>
	<Folder Include="Protos\" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="FluentdForward.OpenTelemetry.MessagePack" Version="0.3.8" />
	<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
	<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.9.0" />
	<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0" />
	<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.9.0" />
	<PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.9.0" />
	<PackageReference Include="PhoenixToolkits.MessageQueue.Nats" Version="2.2.0" />
	<PackageReference Include="ProfileViewer.OpenTelemetry.Exporter" Version="0.3.1" />
	<PackageReference Include="Sentry.AspNetCore" Version="4.10.2" />
	<PackageReference Include="Tgs.MessageQueue.Nats.Serializers" Version="0.0.2" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Payment.WithdrawLimit.Core\Payment.WithdrawLimit.Core.csproj" />
	<ProjectReference Include="..\Payment.WithdrawLimit.Repositories\Payment.WithdrawLimit.Repositories.csproj" />
  </ItemGroup>

</Project>
